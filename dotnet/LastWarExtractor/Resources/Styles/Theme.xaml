<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:LastWarExtractor.Views">

    <conv:NotEmptyConverter x:Key="NotEmpty" />
    <conv:InvertBoolConverter x:Key="Invert" />
    <conv:CountToBoolConverter x:Key="CountToBool" />

    <!-- Palette (from the TypeScript UI) -->
    <Color x:Key="TextColor">#17231F</Color>
    <Color x:Key="BodyBg">#E9EEE9</Color>
    <Color x:Key="PanelBg">#F7FAF6</Color>
    <Color x:Key="LineColor">#CFDBD1</Color>
    <Color x:Key="InputLine">#AFC0B3</Color>
    <Color x:Key="Muted">#668071</Color>
    <Color x:Key="Muted2">#71847A</Color>
    <Color x:Key="PrimaryBg">#17231F</Color>
    <Color x:Key="PrimaryText">#F4F7F2</Color>
    <Color x:Key="SecondaryBg">#DCE8DD</Color>
    <Color x:Key="SecondaryText">#294236</Color>
    <Color x:Key="ToggleBg">#E2EBE3</Color>
    <Color x:Key="MatchedBorder">#9AB5A1</Color>
    <Color x:Key="NeedsReviewBorder">#C27B55</Color>
    <Color x:Key="SuccessText">#2E7D32</Color>
    <Color x:Key="SuccessBg">#E8F5E9</Color>
    <Color x:Key="ErrorText">#C62828</Color>
    <Color x:Key="ErrorBg">#FFEBEE</Color>
    <Color x:Key="WarningText">#8A6D1F</Color>
    <Color x:Key="WarningBg">#FFF8E6</Color>
    <Color x:Key="ConnReady">#78A56F</Color>
    <Color x:Key="ConnBusy">#D9A441</Color>

    <x:String x:Key="MonoFont">Consolas</x:String>

    <!-- Text styles -->
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Muted2}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="0.5" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBg}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBg}" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="18,14" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Inputs -->
    <Style x:Key="Field" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted2}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style x:Key="FieldPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <!-- Visible container that marks a control as an editable field -->
    <Style x:Key="InputShell" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#FFFFFF" />
        <Setter Property="Stroke" Value="{StaticResource InputLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PanelBg}" />
        <Setter Property="Stroke" Value="{StaticResource LineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

</ResourceDictionary>
