<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:lawar4.Views">

    <conv:NotEmptyConverter x:Key="NotEmpty" />
    <conv:InvertBoolConverter x:Key="Invert" />
    <conv:CountToBoolConverter x:Key="CountToBool" />

    <!-- Palette (Tactical Zombie Hunting / Command Center HUD) -->
    <Color x:Key="TextColor">#F0F4F8</Color>
    <Color x:Key="BodyBg">#121619</Color>
    <Color x:Key="PanelBg">#1A2026</Color>
    <Color x:Key="LineColor">#344452</Color>
    <Color x:Key="InputLine">#415363</Color>
    <Color x:Key="Muted">#7A8C9E</Color>
    <Color x:Key="Muted2">#A0B0C0</Color>
    <Color x:Key="PrimaryBg">#FF6B00</Color>
    <Color x:Key="PrimaryText">#101417</Color>
    <Color x:Key="SecondaryBg">#2C3844</Color>
    <Color x:Key="SecondaryText">#00E676</Color>
    <Color x:Key="ToggleBg">#1D2630</Color>
    <Color x:Key="MatchedBorder">#00E676</Color>
    <Color x:Key="NeedsReviewBorder">#FF9800</Color>
    <Color x:Key="SuccessText">#00E676</Color>
    <Color x:Key="SuccessBg">#0C2B1B</Color>
    <Color x:Key="ErrorText">#FF3333</Color>
    <Color x:Key="ErrorBg">#2D1214</Color>
    <Color x:Key="WarningText">#FFC107</Color>
    <Color x:Key="WarningBg">#2B220C</Color>
    <Color x:Key="ConnReady">#00E676</Color>
    <Color x:Key="ConnBusy">#FFC107</Color>

    <x:String x:Key="MonoFont">Consolas</x:String>

    <!-- Text styles -->
    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.8" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryBg}" />
    </Style>

    <Style x:Key="H1" TargetType="Label">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
    </Style>

    <Style x:Key="H2" TargetType="Label">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Muted2}" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.0" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <!-- Buttons: heights standardized here so rows align regardless of label length -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBg}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource SecondaryBg}" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryText}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="18,12" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="CompactButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="MinimumHeightRequest" Value="40" />
    </Style>

    <!-- Inputs: transparent so the InputShell Border is the only visible box (native WinUI
         chrome for the underlying TextBox/ComboBox is stripped in MauiProgram.cs) -->
    <Style x:Key="Field" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="FieldPicker" TargetType="Picker">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Opacity" Value="0.5" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Visible container that marks a control as an editable field -->
    <Style x:Key="InputShell" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#232B33" />
        <Setter Property="Stroke" Value="{StaticResource InputLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 4" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PanelBg}" />
        <Setter Property="Stroke" Value="{StaticResource LineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="StrokeShape" Value="Rectangle" />
    </Style>

    <!-- Shared width for the main Setup/Roster/Recon workflow cards so the desktop layout
         reads as one consistent column; shrinks below 720 on narrower windows. -->
    <Style x:Key="WorkflowCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="MaximumWidthRequest" Value="720" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

</ResourceDictionary>
